{
  "name": "meera-drafts-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram bot that turns Meera's notes into LinkedIn drafts in her voice using Gemini. Runs on Vercel.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "set-webhook": "node --env-file=.env.local scripts/set-webhook.js",
    "webhook-info": "node --env-file=.env.local scripts/set-webhook.js --info",
    "draft": "node --env-file=.env.local scripts/try-draft.js",
    "test:guardrail": "node --env-file=.env.local scripts/test-guardrail.js",
    "news": "node --env-file=.env.local scripts/try-news.js"
  }
}
