# Copy to .env.local for local scripts, and add the same values in
# Vercel -> Project -> Settings -> Environment Variables.

# From @BotFather
TELEGRAM_BOT_TOKEN=

# Any long random string (letters, digits, _ and - only). Telegram sends it
# back on every webhook call so the function can reject forged requests.
TELEGRAM_WEBHOOK_SECRET=

# Comma-separated Telegram chat IDs allowed to use the bot (Meera's chat).
# Leave empty at first: the bot will reply with your chat ID, then fill it in.
ALLOWED_CHAT_IDS=

# From Google AI Studio (aistudio.google.com/apikey). New keys look like "AQ.Ab8..."
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Tried in order if the main model is overloaded (503/429) or unavailable.
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-flash-latest

# Daily news drafts (api/news-drafts.js, run by Vercel Cron).
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>". Required, or the job refuses to run.
CRON_SECRET=
# Optional. Where news drafts are posted (defaults to the first ALLOWED_CHAT_IDS entry).
NEWS_CHAT_ID=
# Optional. Google News search query (default: skincare, cosmetics, CDSCO and similar, last 24h).
NEWS_QUERY=
# Optional. Maximum stories to draft per day (default 3).
NEWS_MAX_DRAFTS=

# Only needed by scripts/set-webhook.js, e.g. https://meera-drafts-bot.vercel.app
PUBLIC_URL=
